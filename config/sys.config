[
  {p59_punto_de_venta, [
    %% Puerto HTTP (variable de entorno P59_PUERTO tiene prioridad).
    {puerto, 8059},
    %% Carpeta de los archivos DETS (P59_DATA_DIR tiene prioridad). Relativa al
    %% directorio de trabajo: en el release es la raiz del release.
    {data_dir, "data"},
    {num_cajas, 4},
    {num_productos, 800},
    {semilla_catalogo, 59},
    %% IVA en puntos base: 1600 = 16 % general. Para el estimulo fiscal de la
    %% region fronteriza norte usar 800 (ver README: vigencia por verificar).
    {iva_general_pb, 1600},
    %% Tipo de cambio SIMULADO en diezmilesimos: 182000 = 18.2000 MXN por USD.
    {tipo_cambio_inicial, 182000},
    {tipo_cambio_variacion_ms, 30000},
    %% Tiempo que se espera a la terminal bancaria simulada antes de declarar
    %% "sin respuesta" y mandar la venta a revision.
    {terminal_timeout_ms, 3000},
    %% Fondo de caja al abrir turno, en centavos ($1,000.00).
    {fondo_inicial, 100000}
  ]},
  {kernel, [
    {logger_level, info}
  ]}
].
